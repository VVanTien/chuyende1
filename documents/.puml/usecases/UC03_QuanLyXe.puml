@startuml UC03 - Quản lý xe ô tô
' =============================================
' UC03: Quản lý xe ô tô
' Đồ án: Website quản lý bán ô tô
' =============================================

left to right direction
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #FEFECE
  BorderColor #A80036
  ArrowColor #333333
}

actor "Admin" as Admin

rectangle "Hệ thống quản lý bán ô tô" {
  usecase "Quản lý xe\nô tô" as UC_Main

  usecase "Xem danh sách xe" as UC_Xem
  usecase "Thêm xe mới" as UC_Them
  usecase "Cập nhật\nthông tin xe" as UC_Sua
  usecase "Xóa xe" as UC_Xoa

  usecase "Tìm kiếm xe\n(tên / mã VIN)" as UC_TimKiem
  usecase "Lọc theo hãng /\ndòng xe / trạng thái" as UC_Loc
  usecase "Upload ảnh\nđại diện xe" as UC_Upload
}

Admin --> UC_Main

UC_Main ..> UC_Xem : <<include>>

UC_Them ..> UC_Main : <<extend>>
UC_Sua ..> UC_Main : <<extend>>
UC_Xoa ..> UC_Main : <<extend>>
UC_TimKiem ..> UC_Xem : <<extend>>
UC_Loc ..> UC_Xem : <<extend>>
UC_Upload ..> UC_Them : <<include>>
UC_Upload ..> UC_Sua : <<include>>

@enduml

