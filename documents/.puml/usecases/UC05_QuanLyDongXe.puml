@startuml UC05 - Quản lý dòng xe
' =============================================
' UC05: Quản lý dòng xe (Category)
' Đồ án: Website quản lý bán ô tô
' =============================================

left to right direction
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #FEFECE
  BorderColor #A80036
  ArrowColor #333333
}

actor "Admin" as Admin

rectangle "Hệ thống quản lý bán ô tô" {
  usecase "Quản lý\ndòng xe" as UC_Main

  usecase "Xem danh sách\ndòng xe" as UC_Xem
  usecase "Thêm dòng xe mới" as UC_Them
  usecase "Cập nhật\nthông tin dòng xe" as UC_Sua
  usecase "Xóa dòng xe" as UC_Xoa

  usecase "Tìm kiếm dòng xe\n(tên / slug)" as UC_TimKiem
}

Admin --> UC_Main

UC_Main ..> UC_Xem : <<include>>

UC_Them ..> UC_Main : <<extend>>
UC_Sua ..> UC_Main : <<extend>>
UC_Xoa ..> UC_Main : <<extend>>
UC_TimKiem ..> UC_Xem : <<extend>>

@enduml

