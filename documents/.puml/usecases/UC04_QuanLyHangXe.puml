@startuml UC04 - Quản lý hãng xe
' =============================================
' UC04: Quản lý hãng xe (Brand)
' Đồ án: Website quản lý bán ô tô
' =============================================

left to right direction
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #FEFECE
  BorderColor #A80036
  ArrowColor #333333
}

actor "Admin" as Admin

rectangle "Hệ thống quản lý bán ô tô" {
  usecase "Quản lý\nhãng xe" as UC_Main

  usecase "Xem danh sách\nhãng xe" as UC_Xem
  usecase "Thêm hãng xe mới" as UC_Them
  usecase "Cập nhật\nthông tin hãng xe" as UC_Sua
  usecase "Xóa hãng xe" as UC_Xoa

  usecase "Tìm kiếm hãng xe\n(tên / quốc gia)" as UC_TimKiem
  usecase "Lọc theo quốc gia /\ntrạng thái" as UC_Loc
  usecase "Upload logo\nhãng xe" as UC_Upload
}

Admin --> UC_Main

UC_Main ..> UC_Xem : <<include>>

UC_Them ..> UC_Main : <<extend>>
UC_Sua ..> UC_Main : <<extend>>
UC_Xoa ..> UC_Main : <<extend>>
UC_TimKiem ..> UC_Xem : <<extend>>
UC_Loc ..> UC_Xem : <<extend>>
UC_Upload ..> UC_Them : <<include>>
UC_Upload ..> UC_Sua : <<include>>

@enduml

